# Database
DATABASE_URL=mysql+aiomysql://root:password@127.0.0.1:3306/nutrigen

# API Keys (optional for testing, system includes robust local mocks & caches)
USDA_API_KEY=DEMO_KEY
DATA_GOV_IN_API_KEY=
CEDA_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=

# App Settings
APP_ENV=development
MAX_ROUNDS=3
AGENT_TIMEOUT_SECONDS=30

# Security (set these on the host in production)
# Long random string that signs login tokens. Required in production.
AUTH_TOKEN_SECRET=
# Website(s) allowed to call the API from a browser (comma separated, no trailing slash).
# Required in production; in development any localhost port is allowed.
FRONTEND_ORIGINS=
# Days without using the app before a user has to sign in again.
REFRESH_TOKEN_TTL_DAYS=30
# Verbose logging for local debugging only.
DEBUG=false
